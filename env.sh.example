# PoC 환경 변수. 복사해서 env.sh로 사용한다: cp env.sh.example env.sh
# env.sh는 git에 포함되지 않는다.

# --- 구성: single = SDN01 한 대에 안쪽 VM 6대 전부 / dual = 호스트 A·B 두 대 (계획서 원안) ---
POC_TOPOLOGY="single"

# --- SSH 접속 (로컬 노트북 → 원격 호스트) ---
HOST_A_SSH="user@host-a.example"      # 호스트 A (단말, faucet-ctl, br-sdn)
HOST_B_SSH="user@host-b.example"      # 호스트 B (radius, fw, br-trunk)
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"   # 필요 시 -i ~/.ssh/<key> 추가
REMOTE_DIR="poc"                      # 호스트 VM 안 저장소 위치 (홈 기준). tools/push.sh가 여기로 복사
# 예 (Proxmox, 노트북에서 VPN 경유): HOST_A_SSH="ubuntu@192.168.50.21"

# --- 호스트 관리 NIC (NIC 1) = Proxmox vmbr0 쪽 (SSH·apt·인터넷). 절대 수정 금지. 기록용 ---
# (PoC 관리망 10.255.0.0/24 와는 다름: 그건 vmbr1 위의 VXLAN key 300 오버레이)
HOST_A_MGMT_NIC=""
HOST_B_MGMT_NIC=""

# --- 터널 NIC (NIC 2): VXLAN 언더레이. Proxmox vmbr1 쪽 NIC (보통 ens19) ---
# 예: HOST_A_TUN_NIC="ens19" HOST_A_TUN_IP="10.10.0.1"  /  HOST_B_TUN_IP="10.10.0.2"
HOST_A_TUN_NIC=""
HOST_B_TUN_NIC=""
HOST_A_TUN_IP=""
HOST_B_TUN_IP=""

# --- MTU (Phase 0 측정으로 확정) ---
# 1522바이트 페이로드 DF ping 통과 → 1500, 실패 → 1450
VM_MTU=""

# --- fw VM 외부 출구 ---
FW_EGRESS_NET="default"               # 호스트 B libvirt 네트워크 이름

# --- 관리 오버레이 (고정) ---
MGMT_NET="10.255.0.0/24"
HOST_A_MGMT_OVL_IP="10.255.0.11"
HOST_B_MGMT_OVL_IP="10.255.0.12"
