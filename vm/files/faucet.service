[Unit]
Description=Faucet OpenFlow controller (PoC)
After=network-online.target
Wants=network-online.target

[Service]
# faucet 은 내부 엔진(osken-manager)을 이름으로 실행하므로 venv bin 이 PATH 에 있어야 한다
Environment=PATH=/opt/faucet/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=FAUCET_CONFIG=/etc/faucet/faucet.yaml
Environment=FAUCET_LOG=/var/log/faucet/faucet.log
Environment=FAUCET_EXCEPTION_LOG=/var/log/faucet/faucet_exception.log
ExecStart=/opt/faucet/bin/faucet
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
