# FreeRADIUS 3.2 mods-available/eap — EAP-TLS만 허용 (PEAP·TTLS·MD5·MSCHAPv2·GTC 제거)
eap {
	default_eap_type = tls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_file = ${certdir}/poc/radius.key
		certificate_file = ${certdir}/poc/radius.pem
		# 신뢰 CA는 PoC CA 하나만. ca_path도 이 파일만 있는 디렉터리로 한정.
		ca_file = ${certdir}/poc/ca.pem
		ca_path = ${certdir}/poc/trust
		cipher_list = "DEFAULT"
		cipher_server_preference = no
		tls_min_version = "1.2"
		tls_max_version = "1.2"
		ecdh_curve = ""

		# 인증서 CN이 EAP Identity(User-Name)와 같아야 한다.
		# → 다른 단말의 인증서로 vm-biz01 을 사칭할 수 없음.
		check_cert_cn = %{User-Name}

		# 단편화 크기 (t12, 큰 인증서). 관리망 MTU 1500 기준.
		fragment_size = 1024

		cache {
			enable = no
		}
		verify {
		}
		ocsp {
			enable = no
		}
	}

	tls {
		tls = tls-common
	}
}
